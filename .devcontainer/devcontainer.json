{
  "name": "Foroughi & Co — site preview",
  "image": "mcr.microsoft.com/devcontainers/python:3",

  // The site is static, so a plain file server over the repo root is the whole
  // build step. Serving on 8000 from the workspace folder means index.html is
  // the root of the preview, exactly as it will be in production.
  "postAttachCommand": "python3 -m http.server 8000",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Site preview",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ritwickdey.liveserver"
      ]
    }
  }
}
